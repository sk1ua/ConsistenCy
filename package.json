{
  "name": "consistency-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:runtime-gate": "vitest run scripts/verify-baseline.test.mjs",
    "test": "npm run test:workspaces && npm run test:runtime-gate",
    "build": "npm run build --workspaces --if-present",
    "test:python": "python -m pytest -q",
    "test:e2e": "playwright test",
    "capture:screenshots": "playwright test --config=playwright.capture.config.ts tests/e2e/capture-screenshots.spec.ts",
    "audit:deps": "npm audit --audit-level=high",
    "verify:runtime": "node scripts/verify-baseline.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify": "npm run verify:runtime && npm run verify:docs && npm run audit:deps && npm run typecheck && npm test && npm run build && npm run test:python && npm run test:e2e",
    "setup": "tsx apps/api/src/config/cli.ts setup",
    "config": "tsx apps/api/src/config/cli.ts config",
    "data:import": "tsx apps/api/src/data/importRealData.ts",
    "dev:webhook": "node scripts/dev-webhook.mjs",
    "dev:api": "npm run dev -w @consistency/api",
    "dev:web": "npm run dev -w @consistency/web"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
