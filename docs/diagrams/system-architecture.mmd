flowchart LR
  web["React/Vite Web UI"] --> api["TypeScript API"]
  github["GitHub App / Webhooks"] -.-> api
  api --> jobs[("SQLite Jobs")]
  api --> review["Review Worker"]
  review --> context["PR Context + Workspace"]
  review --> protocol["JSON-over-stdio"]
  protocol --> engine["Python Deterministic Engine"]
  review --> agents["Planner + Optional LLM Agents"]
  engine --> report[("Reports + Agent Runs")]
  agents --> report
  report --> outbox[("SQLite Outbox")]
  outbox --> publish["Publish Worker"]
  publish -.-> github
  publish --> leases["Lease + Fencing Token"]
  leases --> outbox

  classDef product fill:#17202a,color:#f6f8f5,stroke:#2f6bff,stroke-width:2px;
  classDef storage fill:#eef3ff,color:#17202a,stroke:#2f6bff,stroke-width:2px;
  classDef boundary fill:#e8f5f1,color:#17202a,stroke:#16856b,stroke-width:2px;
  class web,api,review,publish product;
  class jobs,report,outbox,leases storage;
  class context,protocol,engine,agents boundary;
