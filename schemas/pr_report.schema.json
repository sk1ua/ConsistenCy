{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sk1ua/ConsistenCy/schemas/pr_report.schema.json",
  "title": "ConsistenCy PR risk report",
  "description": "Contract for AnalysisPipeline.pr_risk_report and backend.cli pr-report JSON output.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "base_ref",
    "head_ref",
    "commit_count",
    "avg_risk",
    "max_risk",
    "high_risk_commits",
    "commits",
    "commit_trend",
    "risk_composition",
    "evidence_summary",
    "top_risky_files",
    "file_deep_dive",
    "security_findings",
    "agent_collaboration",
    "code_snippets",
    "cache"
  ],
  "properties": {
    "base_ref": { "type": "string" },
    "head_ref": { "type": "string" },
    "commit_count": { "type": "integer", "minimum": 0 },
    "avg_risk": { "$ref": "#/$defs/score" },
    "max_risk": { "$ref": "#/$defs/score" },
    "high_risk_commits": { "type": "integer", "minimum": 0 },
    "commits": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitEntry" }
    },
    "commit_trend": {
      "type": "array",
      "items": { "$ref": "#/$defs/commitTrendEntry" }
    },
    "risk_composition": { "$ref": "#/$defs/riskComposition" },
    "evidence_summary": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceSummaryItem" }
    },
    "top_risky_files": {
      "type": "array",
      "items": { "$ref": "#/$defs/topRiskyFile" }
    },
    "file_deep_dive": {
      "type": "array",
      "items": { "$ref": "#/$defs/fileDeepDive" }
    },
    "retrieval": { "$ref": "#/$defs/retrieval" },
    "security_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/securityFinding" }
    },
    "agent_collaboration": { "$ref": "#/$defs/agentCollaboration" },
    "code_snippets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "cache": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    }
  },
  "$defs": {
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signalScoreMap": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "properties": {
        "style": { "type": "number" },
        "structural": { "type": "number" },
        "semantic": { "type": "number" },
        "duplication": { "type": "number" },
        "security": { "type": "number" },
        "evolution": { "type": "number" }
      }
    },
    "commitEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sha",
        "date",
        "author",
        "message",
        "risk_score",
        "risk_level",
        "evolution_score",
        "evolution_details",
        "files_analyzed",
        "evolution_evidence"
      ],
      "properties": {
        "sha": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "message": { "type": "string" },
        "risk_score": { "$ref": "#/$defs/score" },
        "risk_level": { "type": "string" },
        "evolution_score": { "$ref": "#/$defs/score" },
        "evolution_details": { "type": "object" },
        "files_analyzed": { "type": "integer", "minimum": 0 },
        "evolution_evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "commitTrendEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sha", "date", "risk_score", "delta", "delta_pct"],
      "properties": {
        "sha": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "risk_score": { "$ref": "#/$defs/score" },
        "delta": { "$ref": "#/$defs/nullableNumber" },
        "delta_pct": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "riskComposition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "formula",
        "file_formula",
        "components_avg",
        "contributions_pct",
        "percentile_basis",
        "scale_max"
      ],
      "properties": {
        "formula": { "type": "string" },
        "file_formula": { "type": "string" },
        "components_avg": { "$ref": "#/$defs/signalScoreMap" },
        "contributions_pct": { "$ref": "#/$defs/signalScoreMap" },
        "percentile_basis": { "type": "string" },
        "scale_max": { "type": "number" },
        "confidence_formula": { "type": "string" }
      }
    },
    "evidenceSummaryItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "text"],
      "properties": {
        "type": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["signal_name", "text"],
      "properties": {
        "signal_name": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number" },
        "metadata": { "type": "object" }
      }
    },
    "explainability": {
      "type": "object",
      "additionalProperties": true,
      "required": ["dominant_signals", "contributions", "evidence_chain", "confidence"],
      "properties": {
        "dominant_signals": { "$ref": "#/$defs/stringList" },
        "contributions": { "$ref": "#/$defs/signalScoreMap" },
        "evidence_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "confidence": { "$ref": "#/$defs/score" },
        "uncertainty_note": { "type": "string" }
      }
    },
    "topRiskyFile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "avg_risk",
        "max_risk",
        "hits",
        "churn_lines",
        "complexity",
        "owner",
        "owner_share",
        "risk_breakdown",
        "signal_composition",
        "dominant_signals",
        "confidence",
        "rank_in_pr",
        "total_pr_files",
        "review_effort_min",
        "review_effort_max",
        "agent_collaboration"
      ],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "avg_risk": { "$ref": "#/$defs/score" },
        "max_risk": { "$ref": "#/$defs/score" },
        "hits": { "type": "integer", "minimum": 0 },
        "churn_lines": { "type": "integer", "minimum": 0 },
        "complexity": { "type": "number", "minimum": 0 },
        "owner": { "type": "string" },
        "owner_share": { "$ref": "#/$defs/score" },
        "hotspot_impact": { "$ref": "#/$defs/score" },
        "risk_breakdown": { "$ref": "#/$defs/signalScoreMap" },
        "signal_composition": { "$ref": "#/$defs/signalScoreMap" },
        "dominant_signals": { "$ref": "#/$defs/stringList" },
        "confidence": { "$ref": "#/$defs/score" },
        "explainability": { "$ref": "#/$defs/explainability" },
        "agent_collaboration": { "$ref": "#/$defs/agentCollaboration" },
        "risk_percentile": { "$ref": "#/$defs/score" },
        "rank_in_pr": { "type": "integer", "minimum": 1 },
        "total_pr_files": { "type": "integer", "minimum": 1 },
        "review_effort_min": { "type": "integer", "minimum": 0 },
        "review_effort_max": { "type": "integer", "minimum": 0 }
      }
    },
    "fileDeepDive": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "risk",
        "rank_in_pr",
        "total_pr_files",
        "risk_breakdown",
        "signal_contributions",
        "dominant_signals",
        "confidence",
        "evidence_chain",
        "risky_lines",
        "primary_risk_region",
        "estimated_review_effort",
        "structural_signals",
        "semantic_signals",
        "code_excerpt",
        "diff_excerpt"
      ],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "risk": { "$ref": "#/$defs/score" },
        "rank_in_pr": { "type": "integer", "minimum": 1 },
        "total_pr_files": { "type": "integer", "minimum": 1 },
        "risk_breakdown": { "$ref": "#/$defs/signalScoreMap" },
        "signal_contributions": { "$ref": "#/$defs/signalScoreMap" },
        "dominant_signals": { "$ref": "#/$defs/stringList" },
        "confidence": { "$ref": "#/$defs/score" },
        "evidence_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceItem" }
        },
        "risky_lines": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "primary_risk_region": { "type": "string" },
        "estimated_review_effort": { "type": "string" },
        "structural_signals": { "$ref": "#/$defs/stringList" },
        "semantic_signals": { "$ref": "#/$defs/stringList" },
        "code_excerpt": { "type": "string" },
        "diff_excerpt": { "type": "string" },
        "evidence_pack": { "$ref": "#/$defs/evidencePack" }
      }
    },
    "evidenceQuery": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "path_terms",
        "symbol_terms",
        "import_terms",
        "risk_terms",
        "natural_query",
        "metadata"
      ],
      "properties": {
        "file": { "type": "string" },
        "path_terms": { "$ref": "#/$defs/stringList" },
        "symbol_terms": { "$ref": "#/$defs/stringList" },
        "import_terms": { "$ref": "#/$defs/stringList" },
        "risk_terms": { "$ref": "#/$defs/stringList" },
        "natural_query": { "type": "string" },
        "metadata": { "type": "object" }
      }
    },
    "evidenceCandidate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "file", "kind", "source", "content"],
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": [
            "changed_hunk",
            "file_snippet",
            "baseline_snippet",
            "history_signal",
            "agent_finding",
            "import_context",
            "callsite_hint",
            "review_comment_hint",
            "security_hint",
            "evolution_hint"
          ]
        },
        "source": { "type": "string" },
        "content": { "type": "string" },
        "start_line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "metadata": { "type": "object" }
      }
    },
    "evidenceScore": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total"],
      "properties": {
        "total": { "type": "number" },
        "path_relevance": { "type": "number" },
        "symbol_overlap": { "type": "number" },
        "import_overlap": { "type": "number" },
        "risk_signal_overlap": { "type": "number" },
        "changed_line_proximity": { "type": "number" },
        "severity_boost": { "type": "number" },
        "history_boost": { "type": "number" },
        "security_boost": { "type": "number" },
        "local_similarity": { "type": "number" },
        "reasons": { "$ref": "#/$defs/stringList" }
      }
    },
    "selectedEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate", "score", "why_selected"],
      "properties": {
        "candidate": { "$ref": "#/$defs/evidenceCandidate" },
        "score": { "$ref": "#/$defs/evidenceScore" },
        "why_selected": { "$ref": "#/$defs/stringList" }
      }
    },
    "discardedEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["candidate_id", "kind", "score", "why_discarded"],
      "properties": {
        "candidate_id": { "type": "string" },
        "kind": { "type": "string" },
        "score": { "type": "number" },
        "why_discarded": { "$ref": "#/$defs/stringList" }
      }
    },
    "evidencePack": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "retrieval_strategy",
        "context_budget_tokens",
        "query",
        "selected_evidence",
        "discarded_candidates",
        "compression"
      ],
      "properties": {
        "file": { "type": "string" },
        "retrieval_strategy": { "type": "string" },
        "context_budget_tokens": { "type": "integer", "minimum": 0 },
        "query": { "$ref": "#/$defs/evidenceQuery" },
        "selected_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectedEvidence" }
        },
        "discarded_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/discardedEvidence" }
        },
        "compression": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "candidate_count": { "type": "integer", "minimum": 0 },
            "selected_count": { "type": "integer", "minimum": 0 },
            "estimated_input_tokens": { "type": "integer", "minimum": 0 },
            "estimated_output_tokens": { "type": "integer", "minimum": 0 },
            "compression_ratio": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["strategy", "context_budget_tokens", "packs", "summary"],
      "properties": {
        "strategy": { "type": "string" },
        "context_budget_tokens": { "type": "integer", "minimum": 0 },
        "packs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidencePack" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "files_with_evidence",
            "total_selected_evidence",
            "average_selected_evidence_count",
            "average_compression_ratio"
          ],
          "properties": {
            "files_with_evidence": { "type": "integer", "minimum": 0 },
            "total_selected_evidence": { "type": "integer", "minimum": 0 },
            "average_selected_evidence_count": { "type": "number", "minimum": 0 },
            "average_compression_ratio": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "securityFinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["filepath", "commit_sha", "author", "evidence"],
      "properties": {
        "filepath": { "type": "string" },
        "commit_sha": { "type": "string" },
        "author": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "agentCollaboration": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scope",
        "decision",
        "consensus_score",
        "confidence",
        "quorum",
        "participants",
        "protocol"
      ],
      "properties": {
        "scope": { "type": "string" },
        "decision": { "type": "string" },
        "consensus_score": { "$ref": "#/$defs/score" },
        "confidence": { "$ref": "#/$defs/score" },
        "quorum": { "type": "string" },
        "participants": { "$ref": "#/$defs/stringList" },
        "votes": {
          "type": "array",
          "items": { "type": "object" }
        },
        "top_findings": {
          "type": "array",
          "items": { "type": "object" }
        },
        "disagreements": { "$ref": "#/$defs/stringList" },
        "next_actions": { "$ref": "#/$defs/stringList" },
        "review_queue": {
          "type": "array",
          "items": { "type": "object" }
        },
        "protocol": { "type": "string" }
      }
    }
  }
}
