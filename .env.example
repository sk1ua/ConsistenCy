# ───────────────────────────────────────────────────────────────────────────────
# ConsistenCy V2 — Environment Configuration
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env. Only 3 values are required to get started:
#   1. LLM_PROVIDER (or leave "mock" for offline demo)
#   2. DEEPSEEK_API_KEY or OPENAI_API_KEY (if using a real LLM)
#   3. CONSISTENCY_API_TOKEN (any string, used to protect the API)
#
# Quick start:
#   cp .env.example .env
#   npm install
#   npm run dev:api    # starts API on :8787
#   npm run dev:web    # starts dashboard on :5173
# ───────────────────────────────────────────────────────────────────────────────

# ── Core API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CONSISTENCY_API_TOKEN=
DATABASE_PATH=.consistency/consistency.db
CONSISTENCY_WORKSPACE_ROOT=.consistency/workspaces
LOG_LEVEL=info

# ── Review Worker ─────────────────────────────────────────────────────────────
CONSISTENCY_WORKERS_ENABLED=true
CONSISTENCY_WORKER_CONCURRENCY=1
CONSISTENCY_WORKER_POLL_INTERVAL_MS=1000

# ── Publish Worker ────────────────────────────────────────────────────────────
CONSISTENCY_PUBLISH_WORKER_CONCURRENCY=1
CONSISTENCY_PUBLISH_WORKER_POLL_INTERVAL_MS=1000
CONSISTENCY_PUBLISH_LEASE_DURATION_MS=30000
CONSISTENCY_PUBLISH_TIMEOUT_MS=15000
CONSISTENCY_PUBLISH_MAX_ATTEMPTS=3

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "mock" (offline demo), "deepseek", "openai"
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── GitHub App (optional — required for webhook-driven PR reviews) ────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Frontend (Vite dev server) ────────────────────────────────────────────────
CONSISTENCY_WEB_URL=http://127.0.0.1:5173
CONSISTENCY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_API_TOKEN=
