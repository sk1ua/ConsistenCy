# ConsistenCy environment variables
# Copy this file to .env and replace only the values needed for your mode.

# TypeScript API
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=.consistency/consistency.db
CONSISTENCY_API_TOKEN=
CONSISTENCY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CONSISTENCY_WORKER_CONCURRENCY=1
LOG_LEVEL=info

# LLM provider. CI and local development default to mock.
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# GitHub App. Required only when GitHub App mode is enabled.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ENCRYPTION_KEY=
GITHUB_APP_ENV=development

# Legacy Flask dashboard
FLASK_DEBUG=false
ALLOWED_REPO_PATHS=
RATE_LIMIT_PER_MINUTE=60
