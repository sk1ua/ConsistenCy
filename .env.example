# ───────────────────────────────────────────────────────────────────────────────
# ConsistenCy — Environment Configuration
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env. Required values to execute reviews:
#   1. DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY (real LLM provider)
#   2. CONSISTENCY_API_TOKEN (optional in dev, required in production)
#
# Quick start:
#   cp .env.example .env
#   npm ci
#   npm run dev:api    # starts API on :8787
# ───────────────────────────────────────────────────────────────────────────────

# ── Core API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CONSISTENCY_API_TOKEN=
DATABASE_PATH=.consistency/consistency.db
CONSISTENCY_WORKSPACE_ROOT=.consistency/workspaces
# Comma-separated directories whose checkouts may be reviewed via POST /reviews/local.
# Unset disables the legacy path-based endpoint. Electron grants local access through
# its main-process folder picker; set exact roots only for explicit headless use.
CONSISTENCY_LOCAL_REVIEW_ROOTS=
# Extra gitignore-style path patterns excluded from local WORKING_TREE reviews
# (in addition to repo-root .consistencyignore). Comma or newline separated.
# Example: artifacts/**,**/dogfood*.ts
CONSISTENCY_LOCAL_REVIEW_EXCLUDE=
# Deterministic review stage: a builtin workflow name, or "legacy" for the
# single-shot analyze action. Workflows with subprocess steps are never used
# here — a review runs against a clone of an untrusted repository.
CONSISTENCY_REVIEW_WORKFLOW=pr-review
# Python for the deterministic engine. Defaults to python3 on Linux/macOS and
# python on Windows. Override with an absolute interpreter path when needed.
# CONSISTENCY_PYTHON_PATH=python3
# Background repository monitor. Enabled by default in development; in
# production it is opt-in because it continuously reads the working tree of
# the project it runs in. Exposes pulses on GET /heartbeat/stream.
CONSISTENCY_HEARTBEAT_ENABLED=false
CONSISTENCY_HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info

# ── Public PR + Repository Notebook ──────────────────────────────────────────
# Development defaults to enabled; production must set these explicitly.
CONSISTENCY_PUBLIC_PR_ANALYSIS_ENABLED=true
# Language of LLM-generated review prose: "zh-CN" (default) or "en-US"
CONSISTENCY_REPORT_LANGUAGE=zh-CN
CONSISTENCY_NOTEBOOK_ENABLED=true
CONSISTENCY_NOTEBOOK_MAX_TOOL_CALLS=8
CONSISTENCY_NOTEBOOK_MAX_CONTEXT_TOKENS=16000
CONSISTENCY_NOTEBOOK_INDEX_MAX_BYTES=67108864

# ── Review Worker ─────────────────────────────────────────────────────────────
CONSISTENCY_WORKERS_ENABLED=true
CONSISTENCY_WORKER_CONCURRENCY=1
CONSISTENCY_WORKER_POLL_INTERVAL_MS=1000

# ── Publish Worker ────────────────────────────────────────────────────────────
CONSISTENCY_PUBLISH_WORKER_CONCURRENCY=1
CONSISTENCY_PUBLISH_WORKER_POLL_INTERVAL_MS=1000
CONSISTENCY_PUBLISH_LEASE_DURATION_MS=30000
CONSISTENCY_PUBLISH_TIMEOUT_MS=15000
CONSISTENCY_PUBLISH_MAX_ATTEMPTS=3

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "deepseek", "openai", or "anthropic" (leave empty/whitespace to auto-detect from API keys;
# empty values are treated as unset so copying .env.example does not crash Zod validation)
# All providers are executed by the bundled official Pi model runtime; keys are
# injected in-memory and never written to Pi config files. No Pi install needed.
LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Server-side isolation directory for the bundled runtime's auth storage.
# Never exposed to the renderer; no user-level ~/.pi directory is read.
CONSISTENCY_PI_CONFIG_DIR=
# Optional Pi models.json for custom model endpoints; default uses the bundled catalog.
CONSISTENCY_PI_MODELS_PATH=
# Optional request temperature, 0–2; leave blank to use the provider default.
CONSISTENCY_LLM_TEMPERATURE=
# Optional endpoint override for the selected provider (proxy, gateway, or any
# OpenAI-compatible base URL). Blank uses the provider/catalog default.
CONSISTENCY_LLM_BASE_URL=
# Maximum main-list findings from each review specialist (default 3).
CONSISTENCY_MAX_FINDINGS_PER_SPECIALIST=3
# Minimum synthesizer score (0-10) for a finding to reach the main list (default 5).
CONSISTENCY_MIN_FINDING_SCORE=5
# Maximum findings in the main list after scoring (default 8).
CONSISTENCY_MAX_REPORTED_FINDINGS=8
# Maximum findings in the main list from any single file (default 3).
CONSISTENCY_MAX_FINDINGS_PER_FILE=3
# Deterministic (Python engine) finding scope: diff keeps only findings anchored
# within 5 lines of the change; all keeps the engine's unscoped output (default diff).
CONSISTENCY_DETERMINISTIC_SCOPE=diff
# CLI only: 1 disables both reads and writes of persisted review knowledge.
# Equivalent to consistency review --no-memory; default 0 preserves history.
CONSISTENCY_NO_MEMORY=0
# Exact 1 runs only Correctness and Consistency, with no Planner call.
# Consistency then uses its own convention prompt and may see unchanged sibling files.
# Unset, 0, and every other value keep the full six-agent review.
CONSISTENCY_LEAN=0
# Exact 1, only with CONSISTENCY_LEAN=1, adds a patch-focused maintainer reviewer
# signed as Maintainability. Default/full-mode Maintainability remains unchanged.
CONSISTENCY_LEAN_REVIEWER=0
# Exact 1 enables the v2 scoring rubric and raises the per-file cap from 3 to 4.
# Unset, 0, and every other value keep the v1 rubric and cap.
CONSISTENCY_SCORE_RUBRIC=0
# Exact 1 replaces full file context with numbered hunks and whole-unit windows.
# Unset, 0, and every other value keep the full numbered file context.
CONSISTENCY_COMPACT_CONTEXT=0
# Exact 1, and only with CONSISTENCY_LEAN=1, tightens Consistency:
# no documentation or boilerplate-absence findings, and source-only sibling files.
# Unset, 0, and every other value leave prompts and reports unchanged.
CONSISTENCY_LEAN_CONSISTENCY_STRICT=0
# Exact 1, and only with CONSISTENCY_LEAN=1, keeps different specialists'
# distinct claims from being merged. Unset, 0, and every other value keep
# the existing cross-agent merge.
CONSISTENCY_LEAN_STRICT_MERGE=0

# ── GitHub App (optional — required for webhook-driven PR reviews) ────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Public PR read-only mode (optional) ──────────────────────────────────────
# Leave empty for anonymous public GitHub API and Git clone access.
# A fine-grained read-only token raises the GitHub API rate limit; keep it server-side.
GITHUB_PUBLIC_READ_TOKEN=

# Public OAuth App client id used only by the browser Device Flow compatibility path.
GITHUB_OAUTH_CLIENT_ID=

# Configure all three values on the product-operated API/broker service. End
# users never enter these values, and the Client Secret must never be shipped
# in the Electron installer or renderer bundle.
CONSISTENCY_DESKTOP_OAUTH_BROKER_URL=
CONSISTENCY_DESKTOP_OAUTH_CLIENT_ID=
CONSISTENCY_DESKTOP_OAUTH_CLIENT_SECRET=

CONSISTENCY_WEB_URL=http://127.0.0.1:5173
CONSISTENCY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Origins allowed to call the API cross-origin. The terminal CLI talks to the
# API same-origin over loopback and needs no entry here; leave these only if you
# run a trusted standalone UI. Never place bearer tokens in client-side bundle
# variables, because the bundler inlines them into the shipped artifact.

# ── Completion reporting to a supervisor channel (optional) ──────────────────
# Explicit destination that receives one-shot terminal run summaries (runId,
# attempt, result, evidence references, remaining budget). Content is redacted:
# no secrets, no raw private prompts. There is NO default destination — unset
# keeps the feature silently off (no outbox writes, no delivery, no timers).
# Production requires an https:// URL. Delivery is event-driven (terminal
# notices + a one-shot startup recovery replay); retries use bounded backoff.
CONSISTENCY_COMPLETION_WEBHOOK_URL=
# Optional bearer credential for the destination. Stays server-side; it is
# never logged, never persisted into the outbox payload, and never exposed in
# any DTO or health payload.
CONSISTENCY_COMPLETION_WEBHOOK_TOKEN=

# ── Diagnostics bundle export & retention (optional, H26) ────────────────────
# Master switch for the diagnostics feature (per-run sanitized trace view and
# JSON diagnostics bundle export under /diagnostics/runs/:runId/bundle, plus
# the local retention sweep). Unset or "false" keeps the feature silently off;
# the health capability projection reports the disabled state honestly.
CONSISTENCY_DIAGNOSTICS_ENABLED=false
# Directory for module-owned diagnostics artifacts. Unset resolves to
# <database dir>/diagnostics. Retention cleanup only ever touches
# "consistency-diagnostics-"-prefixed files inside this directory — user
# review history and reports elsewhere are never scanned or deleted.
#CONSISTENCY_DIAGNOSTICS_RETENTION_DIR=
# Retention limits: max artifact count, max total bytes, and max age in hours.
CONSISTENCY_DIAGNOSTICS_RETENTION_MAX_FILES=200
CONSISTENCY_DIAGNOSTICS_RETENTION_MAX_TOTAL_BYTES=67108864
CONSISTENCY_DIAGNOSTICS_RETENTION_MAX_AGE_HOURS=720
