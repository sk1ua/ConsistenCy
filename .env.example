# ───────────────────────────────────────────────────────────────────────────────
# ConsistenCy — Environment Configuration
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env. Required values to execute reviews:
#   1. DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY (real LLM provider)
#   2. CONSISTENCY_API_TOKEN (optional in dev, required in production)
#
# Quick start:
#   cp .env.example .env
#   npm ci
#   npm run dev:api    # starts API on :8787
#   npm run dev:web    # starts dashboard on :5173
# ───────────────────────────────────────────────────────────────────────────────

# ── Core API ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CONSISTENCY_API_TOKEN=
DATABASE_PATH=.consistency/consistency.db
CONSISTENCY_WORKSPACE_ROOT=.consistency/workspaces
# Comma-separated directories whose checkouts may be reviewed via POST /reviews/local.
# Unset disables the legacy path-based endpoint. Electron grants local access through
# its main-process folder picker; set exact roots only for explicit headless use.
CONSISTENCY_LOCAL_REVIEW_ROOTS=
# Extra gitignore-style path patterns excluded from local WORKING_TREE reviews
# (in addition to repo-root .consistencyignore). Comma or newline separated.
# Example: artifacts/**,**/dogfood*.ts
CONSISTENCY_LOCAL_REVIEW_EXCLUDE=
# Deterministic review stage: a builtin workflow name, or "legacy" for the
# single-shot analyze action. Workflows with subprocess steps are never used
# here — a review runs against a clone of an untrusted repository.
CONSISTENCY_REVIEW_WORKFLOW=pr-review
# Python for the deterministic engine. Defaults to python3 on Linux/macOS and
# python on Windows. Override with an absolute interpreter path when needed.
# CONSISTENCY_PYTHON_PATH=python3
# Background repository monitor. Enabled by default in development; in
# production it is opt-in because it continuously reads the working tree of
# the project it runs in. Exposes pulses on GET /heartbeat/stream.
CONSISTENCY_HEARTBEAT_ENABLED=false
CONSISTENCY_HEARTBEAT_INTERVAL_MS=30000
LOG_LEVEL=info

# ── Public PR + Repository Notebook ──────────────────────────────────────────
# Development defaults to enabled; production must set these explicitly.
CONSISTENCY_PUBLIC_PR_ANALYSIS_ENABLED=true
# Language of LLM-generated review prose: "zh-CN" (default) or "en-US"
CONSISTENCY_REPORT_LANGUAGE=zh-CN
CONSISTENCY_NOTEBOOK_ENABLED=true
CONSISTENCY_NOTEBOOK_MAX_TOOL_CALLS=8
CONSISTENCY_NOTEBOOK_MAX_CONTEXT_TOKENS=16000
CONSISTENCY_NOTEBOOK_INDEX_MAX_BYTES=67108864

# ── Review Worker ─────────────────────────────────────────────────────────────
CONSISTENCY_WORKERS_ENABLED=true
CONSISTENCY_WORKER_CONCURRENCY=1
CONSISTENCY_WORKER_POLL_INTERVAL_MS=1000

# ── Publish Worker ────────────────────────────────────────────────────────────
CONSISTENCY_PUBLISH_WORKER_CONCURRENCY=1
CONSISTENCY_PUBLISH_WORKER_POLL_INTERVAL_MS=1000
CONSISTENCY_PUBLISH_LEASE_DURATION_MS=30000
CONSISTENCY_PUBLISH_TIMEOUT_MS=15000
CONSISTENCY_PUBLISH_MAX_ATTEMPTS=3

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "deepseek", "openai", or "anthropic" (leave empty/whitespace to auto-detect from API keys;
# empty values are treated as unset so copying .env.example does not crash Zod validation)
# All providers are executed by the bundled official Pi model runtime; keys are
# injected in-memory and never written to Pi config files. No Pi install needed.
LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Server-side isolation directory for the bundled runtime's auth storage.
# Never exposed to the renderer; no user-level ~/.pi directory is read.
CONSISTENCY_PI_CONFIG_DIR=

# ── GitHub App (optional — required for webhook-driven PR reviews) ────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ── Public PR read-only mode (optional) ──────────────────────────────────────
# Leave empty for anonymous public GitHub API and Git clone access.
# A fine-grained read-only token raises the GitHub API rate limit; keep it server-side.
GITHUB_PUBLIC_READ_TOKEN=

# Public OAuth App client id used only by the browser Device Flow compatibility path.
GITHUB_OAUTH_CLIENT_ID=

# Configure all three values on the product-operated API/broker service. End
# users never enter these values, and the Client Secret must never be shipped
# in the Electron installer or renderer bundle.
CONSISTENCY_DESKTOP_OAUTH_BROKER_URL=
CONSISTENCY_DESKTOP_OAUTH_CLIENT_ID=
CONSISTENCY_DESKTOP_OAUTH_CLIENT_SECRET=

CONSISTENCY_WEB_URL=http://127.0.0.1:5173
CONSISTENCY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Browser and Electron renderers use the same-origin /api broker. Override
# only when running a standalone trusted development UI; never place bearer
# tokens in VITE_* variables because Vite embeds them in the client bundle.
# Browser development only: Vite proxies the renderer's fixed same-origin
# `/api` endpoint to this server-side target. This value is never bundled.
CONSISTENCY_DEV_API_TARGET=http://127.0.0.1:8787
