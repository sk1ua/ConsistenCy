# ConsistenCy — environment variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.

# =============================================================================
# AI Review (Optional)
# =============================================================================

# DeepSeek API key (get one at https://platform.deepseek.com)
# Required only for --llm-review / AI-generated PR comments.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# GitHub App Mode (Required for GitHub App functionality)
# =============================================================================

# GitHub App ID (from GitHub App settings page)
GITHUB_APP_ID=123456

# Path to GitHub App private key file (.pem)
GITHUB_PRIVATE_KEY=/path/to/your/private-key.pem

# Webhook secret for signature verification
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Encryption key for token storage (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# REQUIRED in production. In development, falls back to obfuscation (NOT secure!)
GITHUB_APP_ENCRYPTION_KEY=your-32-byte-hex-key-here

# Set to "production" to enforce encryption and security requirements
GITHUB_APP_ENV=development

# =============================================================================
# Web UI Configuration
# =============================================================================

# Flask debug mode (set to "true" only for development)
FLASK_DEBUG=false

# Server port (default: 8000)
PORT=8000

# =============================================================================
# Security Hardening (Production)
# =============================================================================

# Allowed repository paths (comma-separated, e.g., "/home/repos,/data/projects")
ALLOWED_REPO_PATHS=

# Rate limiting: requests per minute
RATE_LIMIT_PER_MINUTE=60

# API token for dashboard authentication (if needed)
API_TOKEN=

# =============================================================================
# Database
# =============================================================================

# SQLite database path for GitHub App installations
DATABASE_PATH=.github_app.db
